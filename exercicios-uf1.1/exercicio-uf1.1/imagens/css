  PALETA DE CORES
   Principal: #facc15 (amarelo)
   Texto: #1c1917 (quase preto)
   Secundário: #78716c (cinzento)
   Bordas: #d6d3d1
   Avisos: #fee2e2
   Fundo: #f5f5f4
===================================== */


/* 1. BASE */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #1c1917;
    background-color: #f5f5f4;
}

main {
    max-width: 850px;
    margin: 0 auto;
    padding: 20px 16px;
}


/* 2. TEXTO E FONTES */

h1, h2, h3 {
    font-family: 'Rubik', Arial, sans-serif;
    font-weight: 700;
}

h1 {
    font-size: 2.5rem;
    margin: 20px 0;
}

h2 {
    font-size: 1.8rem;
    margin: 30px 0 20px;
    border-left: 6px solid #facc15;
    padding-left: 12px;
}

h3 {
    font-size: 1.25rem;
}

p {
    font-size: 1rem;
    margin: 0 0 16px;
}


/* 3. CABEÇALHO E MENU */

header {
    background-color: #facc15;
    text-align: center;
    padding: 30px 16px;
    border-bottom: 8px solid #1c1917;
}

header img {
    background-color: white;
    padding: 10px;
    border: 2px solid #1c1917;
    border-radius: 12px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

.subtitulo {
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 600;
}

nav {
    margin-top: 20px;
}

nav a {
    display: inline-block;
    padding: 10px 18px;
    margin: 5px;
    background-color: #1c1917;
    color: #facc15;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 999px;
}

nav a:hover {
    background-color: #44403c;
}


/* 4. CONTEÚDO */

.introducao {
    font-size: 1.15rem;
    margin: 25px 0;
}


/* 5. CARTÕES E ETIQUETAS */

.cartao {
    background-color: white;
    border: 1px solid #d6d3d1;
    border-top: 6px solid #facc15;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
}

.numero-linha {
    display: inline-block;
    padding: 4px 12px;
    background-color: #facc15;
    border: 1px solid #1c1917;
    border-radius: 999px;
    margin-right: 8px;
}


/* 6. CURIOSIDADE E AVISOS */

.curiosidade {
    background-color: rgb(254, 243, 199);
    padding: 20px;
    border-left: 5px solid #d97706;
    border-radius: 8px;
    margin-bottom: 20px;
}

.aviso {
    background-color: hsl(0, 80%, 95%);
    border: 2px dashed #dc2626;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 20px;
}


/* 7. TABELAS */

table {
    width: 100%;
    border-collapse: collapse;
    background-color: white;
}

caption {
    font-weight: 700;
    padding: 10px;
}

th, td {
    border: 1px solid #d6d3d1;
    padding: 12px;
    text-align: left;
}

th {
    background-color: #facc15;
}


/* 8. RODAPÉ */

footer {
    background-color: #1c1917;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}

footer a {
    color: #facc15;
}


/* 9. RESPONSIVIDADE */

@media (max-width: 600px) {
    nav a {
        display: block;
        margin: 8px auto;
        max-width: 220px;
    }

    table {
        font-size: 0.85rem;
    }

    th, td {
        padding: 7px;
    }

    h1 {
        font-size: 2rem;
    }