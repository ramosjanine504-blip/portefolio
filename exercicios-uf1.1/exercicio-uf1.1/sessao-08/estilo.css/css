  cursor: pointer;
}

.botao:hover {
  background-color: #0f172a;
}

.botao.botao-secundario {
  background-color: #ffffff;
  color: #1e3a8a;
  border: 2px solid #1e3a8a;
}

/* ===== Seletor de identificador ===== */
#agendamento {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 1.5rem;
}

#agendamento fieldset {
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  margin-bottom: 1rem;
}

#agendamento label {
  display: block;
  margin-top: 0.5rem;
}

#agendamento input[type="radio"] + label,
#agendamento .inline {
  display: inline;
}