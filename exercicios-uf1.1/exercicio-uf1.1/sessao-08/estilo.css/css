  font-weight: bold;
}

nav a:hover {
  color: #facc15;
}

/* ===== Seletores de classe ===== */
.cartao {
  background-color: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 1rem 1.25rem;
  margin: 1rem 0;
}

.destaque {
  color: #b91c1c;
  font-weight: bold;
}

.aviso {
  background-color: #fef2f2;
  border-left: 6px solid #b91c1c;
  padding: 0.75rem 1rem;
  margin: 1rem 0;
}

.botao {
  background-color: #1e3a8a;
  color: #ffffff;
  border: none;
  border-radius: 6px;
