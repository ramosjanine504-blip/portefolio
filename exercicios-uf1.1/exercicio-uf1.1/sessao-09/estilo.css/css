css
/* ==========================================================
   PALETA (Elétricos de Lisboa)
   Amarelo:             #facc15
   Quase preto:         #1c1917
   Texto secundário:    #57534e
   Bordas:              #d6d3d1
   Vermelho (avisos):   #dc2626
   Fundo da página:     #fafaf9
   ========================================================== */

* {
  box-sizing: border-box;
}

body {
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  line-height: 1.6;
  margin: 0;
  background-color: #fafaf9;
  color: #1c1917;
}

main {
  max-width: 820px;
  margin: 0 auto;
  padding: 0 16px;
}

/* ===== Títulos e texto ===== */
h1, h2, h3 {
  font-family: "Rubik", system-ui, sans-serif;
  font-weight: 700;
  color: #1c1917;
}

h1 {
  font-size: 2.5rem;
  margin: 1rem 0 0.25rem;
}

h2 {
  font-size: 1.6rem;
  margin: 2rem 0 1rem;
  border-left: 8px solid #facc15;
  padding-left: 0.75rem;
}

h3 {
  font-size: 1.2rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
}

p {
  margin: 0 0 1rem 0;
}

a {
  color: #1c1917;
}

.subtitulo {
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 600;
  font-size: 0.9rem;
}

.introducao {
  font-size: 1.15rem;
  margin: 1.5rem 0;
  color: #57534e;
}

/* ===== Cabeçalho e menu ===== */
header {
  background-color: #facc15;
  padding: 1.5rem 1rem;
  border-bottom: 6px solid #1c1917;
  text-align: center;
}

header img {
  background-color: #ffffff;
  padding: 8px;
  border: 3px solid #1c1917;
  border-radius: 12px;
}

nav ul {
  list-style: none;
  margin: 1rem 0 0;
  padding: 0;
}

nav li {
  display: inline-block;
  margin: 0.25rem;
}

nav a {
  display: inline-block;
  padding: 0.5rem 1.1rem;
  background-color: #1c1917;
  color: #facc15;
  text-decoration: none;
  font-weight: 600;
  border-radius: 999px;
}

nav a:hover {
  background-color: #ffffff;
  color: #1c1917;
}

/* ===== Cartões e etiquetas ===== */
.cartao {
  background-color: #ffffff;
  border: 1px solid #d6d3d1;
  border-top: 6px solid #facc15;
  border-radius: 10px;
  padding: 1rem 1.25rem;
  margin-bottom: 1rem;
  box-shadow: 0 2px 6px rgba(28, 25, 23, 0.15);
}

.numero-linha {
  display: inline-block;
  padding: 0.1rem 0.7rem;
  background-color: #facc15;
  border: 2px solid #1c1917;
  border-radius: 999px;
  margin-right: 0.4rem;
}

/* ===== Notas e avisos ===== */
.curiosidade {
  background-color: rgb(254, 249, 195);
  border-left: 6px solid #facc15;
  padding: 0.75rem 1rem;
  margin: 1rem 0;
}

.aviso {
  background-color: hsl(0, 86%, 96%);
  border: 2px dashed #dc2626;
  padding: 0.75rem 1rem;
  margin: 1rem 0;
}

/* ===== Tabela ===== */
table {
  width: 100%;
  border-collapse: collapse;
  background-color: #ffffff;
}

caption {
  text-align: left;
  font-weight: 600;
  padding: 0.5rem 0;
}

th, td {
  border: 1px solid #d6d3d1;
  padding: 0.5rem 0.75rem;
  text-align: left;
}

thead th {
  background-color: #1c1917;
  color: #facc15;
}

/* ===== Rodapé ===== */
footer {
  text-align: center;
  color: #57534e;
  padding: 1.5rem 1rem;
  margin-top: 2rem;
  border-top: 6px solid #facc15;
}
